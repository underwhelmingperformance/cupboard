{
	"name": "cupboard",
	"version": "0.0.0",
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260705.1",
		"@cupboard/cli-ui": "workspace:*",
		"@cupboard/nix-store": "workspace:*",
		"@cupboard/protocol": "workspace:*",
		"@cupboard/reporter": "workspace:*",
		"@cupboard/shared": "workspace:*",
		"@eslint/js": "10.0.1",
		"@logtape/lint": "^2.3.1",
		"@types/node": "^25.9.1",
		"@types/ws": "^8.18.1",
		"cloudflare": "^7.0.0",
		"commander": "^15.0.0",
		"esbuild": "^0.28.1",
		"eslint": "10.9.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"eslint-plugin-unicorn": "73.0.0",
		"globals": "^17.6.0",
		"http-status-codes": "^2.3.0",
		"jiti": "^2.7.0",
		"knip": "^6.15.0",
		"miniflare": "^4.20260730.0",
		"postject": "^1.0.0-alpha.6",
		"prettier": "3.9.6",
		"syncpack": "^15.3.1",
		"testcontainers": "^12.1.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.8",
		"ws": "^8.21.3",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#nix-setting-types": "./packages/nix/src/setting-types.generated.ts",
		"#nix-systems": "./packages/nix/src/nix-systems.ts"
	},
	"license": "AGPL-3.0-or-later",
	"packageManager": "pnpm@11.22.0",
	"private": true,
	"scripts": {
		"bench:push": "pnpm --filter @cupboard/server build-info && vitest bench --run --config tests/perf/vitest.config.ts",
		"build:binary": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/build-cupboard-binary.ts",
		"check": "pnpm run --sequential '/^check:.*/'",
		"check:conformance": "vitest run --config tests/conformance/vitest.config.ts",
		"check:conformance-oracle": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/conformance-oracle.ts check",
		"check:deps": "syncpack lint",
		"check:e2e": "pnpm --filter @cupboard/server build-info && vitest run --config tests/e2e/vitest.config.ts",
		"check:e2e-remote-store": "pnpm --filter @cupboard/server build-info && vitest run --config tests/e2e/remote-store.vitest.config.ts",
		"check:flake-deps": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/flake-dependencies.ts check",
		"check:format": "prettier --check .",
		"check:knip": "knip --include dependencies,unlisted --no-progress",
		"check:lint": "eslint .",
		"check:migrations": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/check-d1-migrations.ts",
		"check:test": "pnpm -r run test && pnpm test:actions && pnpm test:scripts",
		"check:types": "pnpm -r run check:types",
		"check:types:conformance": "tsc -p tests/conformance/tsconfig.json",
		"check:types:perf": "tsc -p tests/perf/tsconfig.json",
		"check:types:predecessor-fixture": "tsc -p tests/fixtures/cache-deployment-predecessor/tsconfig.json",
		"check:types:root": "tsc -p tsconfig.json",
		"check:types:tests": "tsc -p tests/e2e/tsconfig.json",
		"cli": "pnpm --filter @cupboard/cli cli",
		"deploy": "pnpm --filter @cupboard/server deploy",
		"dev": "pnpm --filter @cupboard/server dev",
		"diagnose:push": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/diagnose-push.ts",
		"e2e:pipeline": "pnpm --filter @cupboard/server build-info && vitest run --config tests/e2e/pipeline.vitest.config.ts",
		"fix": "pnpm run '/^fix:.*/'",
		"fix:deps": "syncpack format",
		"fix:format": "prettier --write .",
		"fix:lint": "eslint . --fix",
		"fixtures:generate": "node tests/fixtures/generate.ts",
		"measure:realisation": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/measure-realisation/main.ts",
		"test:actions": "vitest run --config actions/vitest.config.ts",
		"test:scripts": "vitest run scripts --exclude '**/.claude/**'",
		"update:conformance-oracle": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/conformance-oracle.ts update",
		"update:flake-deps": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/flake-dependencies.ts update"
	},
	"type": "module"
}
