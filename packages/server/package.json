{
	"name": "@cupboard/server",
	"version": "0.0.0",
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.14.7",
		"@cloudflare/workers-types": "^4.20260101.0",
		"typescript": "^6.0.2",
		"vitest": "^4.1.6",
		"wrangler": "^4.85.0"
	},
	"main": "src/worker.ts",
	"private": true,
	"scripts": {
		"cf:typegen": "wrangler types --env-interface Env",
		"check:types": "pnpm cf:typegen && tsc --noEmit",
		"deploy": "pnpm cf:typegen && wrangler deploy",
		"dev": "pnpm cf:typegen && wrangler dev",
		"test": "vitest run --passWithNoTests"
	},
	"type": "module"
}
