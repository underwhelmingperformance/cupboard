{
	"name": "@cupboard/server",
	"version": "0.0.0",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1048.0",
		"@aws-sdk/s3-request-presigner": "^3.1048.0",
		"@cupboard/shared": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.19",
		"http-status-codes": "^2.3.0",
		"jose": "^6.2.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.14.7",
		"@cloudflare/workers-types": "^4.20260101.0",
		"drizzle-kit": "^0.31.10",
		"typescript": "^6.0.2",
		"vitest": "^4.1.6",
		"wrangler": "^4.85.0"
	},
	"main": "src/worker.ts",
	"private": true,
	"scripts": {
		"build-info": "node ../../scripts/build-info.ts",
		"cf:typegen": "pnpm build-info && wrangler types --env-interface Env",
		"check:types": "pnpm cf:typegen && tsc --noEmit",
		"deploy": "pnpm cf:typegen && wrangler deploy",
		"dev": "pnpm cf:typegen && wrangler dev",
		"test": "pnpm build-info && vitest run --passWithNoTests"
	},
	"type": "module"
}
