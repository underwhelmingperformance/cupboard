# Local secrets and overrides for `wrangler dev`. Copy to `.dev.vars` and fill
# in. `.dev.vars` is gitignored; this template is committed.
#
# Production secrets are set with `wrangler secret put <NAME>`.

# R2 credentials the Durable Object signs NAR upload credentials with.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_BUCKET_NAME=cupboard-blobs
R2_SECRET_ACCESS_KEY=

# Signs the per-push id the upload credential is scoped to. Sensitive; the deploy
# generates one if absent and it must stay stable afterwards.
PUSH_ID_SIGNING_KEY=

# Control-plane token minting. The audience defaults to `cupboard-control` in
# wrangler.jsonc. The wrapping secret is sensitive and should be set as a Worker
# secret in production.
CUPBOARD_CONTROL_AUDIENCE=
CONTROL_KEY_WRAP_SECRET=

# First-signup bootstrap. The signup secret is sensitive and should be set as a
# Worker secret in production; alternatively pin the subject. Set
# CUPBOARD_LOCAL_DEV to `1` or `true` to allow a loopback HTTP issuer and a
# claim with neither gate configured.
CUPBOARD_SIGNUP_ISSUER=
CUPBOARD_SIGNUP_AUDIENCE=
CUPBOARD_SIGNUP_SECRET=
CUPBOARD_SIGNUP_SUBJECT=
CUPBOARD_LOCAL_DEV=

# Subrequests each invocation may make: `10000` on the Workers Paid plan. Any
# other value, including empty, uses the Free plan's 1000.
CUPBOARD_SUBREQUESTS_PER_INVOCATION=

# Tenant commit limits. Empty uses the built-in value; otherwise a positive
# integer.
CUPBOARD_COMMIT_SOCKET_CEILING=
CUPBOARD_COMMIT_ENTRY_CREDIT_BUDGET=
