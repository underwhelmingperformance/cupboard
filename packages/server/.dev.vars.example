# Local secrets for `wrangler dev`. Copy to `.dev.vars` and fill in.
# `.dev.vars` is gitignored; this template is committed.
#
# Production secrets are set with `wrangler secret put <NAME>`.

# Bearer token required for write and admin routes.
CUPBOARD_WRITE_TOKEN=replace-me
CUPBOARD_BOOTSTRAP_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
