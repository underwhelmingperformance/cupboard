# Local secrets and overrides for `wrangler dev`. Copy to `.dev.vars` and fill
# in. `.dev.vars` is gitignored; this template is committed.
#
# Production secrets are set with `wrangler secret put <NAME>`.

# R2 credentials the Durable Object signs NAR upload credentials with.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_BUCKET_NAME=cupboard-blobs
R2_SECRET_ACCESS_KEY=

# Signs the per-push id the upload credential is scoped to. Sensitive; the deploy
# generates one if absent and it must stay stable afterwards.
PUSH_ID_SIGNING_KEY=

# Control-plane token minting. wrangler.jsonc sets the audience to
# `cupboard-control`. A key in `.dev.vars` replaces the value in wrangler.jsonc
# even when it is empty, and the control plane refuses to issue tokens with an
# empty audience, so uncomment the line only to use another audience. The
# wrapping secret is sensitive and should be set as a Worker secret in
# production.
# CUPBOARD_CONTROL_AUDIENCE=
CONTROL_KEY_WRAP_SECRET=

# The secret that `/signup` requires for the first-admin claim. Set it to claim
# a local deployment: without it the claim is refused, including when
# `CUPBOARD_LOCAL_DEV` is set. `CUPBOARD_LOCAL_DEV=1` allows a loopback HTTP
# OIDC issuer.
CUPBOARD_SIGNUP_SECRET=
CUPBOARD_LOCAL_DEV=

# Subrequests that each invocation may make. Set `10000` for the Workers Paid
# plan. Any other value, including an empty one, selects the Free plan's 1000.
CUPBOARD_SUBREQUESTS_PER_INVOCATION=

# Limits on a tenant's commits. An empty value selects the built-in limit;
# any other value must be a positive integer.
CUPBOARD_COMMIT_SOCKET_CEILING=
CUPBOARD_COMMIT_ENTRY_CREDIT_BUDGET=
