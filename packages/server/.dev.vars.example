# Local secrets and overrides for `wrangler dev`. Copy to `.dev.vars` and fill
# in. `.dev.vars` is gitignored; this template is committed.
#
# Production secrets are set with `wrangler secret put <NAME>`.

# R2 credentials the Durable Object signs NAR upload credentials with.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_BUCKET_NAME=cupboard-blobs
R2_SECRET_ACCESS_KEY=

# Signs the per-push id the upload credential is scoped to. Sensitive; the deploy
# generates one if absent and it must stay stable afterwards.
PUSH_ID_SIGNING_KEY=

# Used to issue control-plane tokens. The audience defaults to
# `cupboard-control` in wrangler.jsonc. The wrapping secret is sensitive, so set
# it as a Worker secret in production.
CUPBOARD_CONTROL_AUDIENCE=
CONTROL_KEY_WRAP_SECRET=

# Used when the first operator claims the deployment. Set either the signup
# secret, or the OIDC subject of the identity that may claim it. The signup
# secret is sensitive, so set it as a Worker secret in production.
#
# Set CUPBOARD_LOCAL_DEV to `1` or `true` for local development. It allows an
# issuer on a loopback HTTP address, and lets you claim the deployment without a
# signup secret or subject.
CUPBOARD_SIGNUP_ISSUER=
CUPBOARD_SIGNUP_AUDIENCE=
CUPBOARD_SIGNUP_SECRET=
CUPBOARD_SIGNUP_SUBJECT=
CUPBOARD_LOCAL_DEV=

# How many subrequests each Worker invocation may make. Set it to `10000` on the
# Workers Paid plan. Any other value, or none, uses the Free plan's limit of
# 1000.
CUPBOARD_SUBREQUESTS_PER_INVOCATION=

# Limits on commits to each tenant. Leave them empty to use the built-in
# values, or set a positive integer.
CUPBOARD_COMMIT_SOCKET_CEILING=
CUPBOARD_COMMIT_ENTRY_CREDIT_BUDGET=
