{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',

	// The org-wide configuration from underwhelmingperformance/.github is
	// applied as self-hosted defaults to every repository, and this file is
	// merged on top of it. Only cupboard-specific additions belong here.

	// The flake builds from a pnpm store pinned by the fixed-output hash in
	// pnpm-deps-hash.json, so a bare pnpm-lock.yaml bump leaves the hash stale
	// and every flake build failing. Refresh the recorded pair on the same
	// branch. `pnpm update:flake-deps` builds the flake, so it needs Nix: the
	// Renovate workflow in underwhelmingperformance/.github installs a real Nix
	// into the container and permits the command through `allowedCommands`.
	postUpgradeTasks: {
		commands: ['pnpm update:flake-deps'],
		fileFilters: ['pnpm-deps-hash.json'],
		executionMode: 'branch'
	}
}
